#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

LOCK_FILE="${TMPDIR:-/tmp}/deepdeep-build.lock"
if command -v flock >/dev/null 2>&1; then
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    echo "[build] 另一个构建正在运行，等待中…" >&2
    flock -w 7200 9 || { echo "[build] 等待构建锁超时（2 小时）" >&2; exit 1; }
  fi
else
  echo "[build] 未找到 flock，跳过构建锁（macOS 可 brew install flock）" >&2
fi

args=()
for arg in "$@"; do
  case "$arg" in
    -Dorg.gradle.jvmargs=*|-Pkotlin.daemon.jvmargs=*)
      echo "[build] 忽略内存参数覆盖：$arg（统一使用 gradle.properties 的 profile）" >&2
      ;;
    *)
      args+=("$arg")
      ;;
  esac
done

exec ./gradlew ${args[@]+"${args[@]}"}
